<Window x:Class="BoykisserExecutor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:local="clr-namespace:BoykisserExecutor"
        Title="Boykisser Executor"
        Height="720" Width="1100"
        MinHeight="480" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="#0d1117"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <Window.Resources>
        <Style TargetType="Button" x:Key="ToolbarBtn">
            <Setter Property="Background" Value="#21262d" />
            <Setter Property="Foreground" Value="#e6edf3" />
            <Setter Property="BorderBrush" Value="#30363d" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#30363d" />
                                <Setter Property="BorderBrush" Value="#8b949e" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#21262d" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListViewItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#8b949e" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border Background="{TemplateBinding Background}"
                                BorderThickness="0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#21262d" />
                                <Setter Property="Foreground" Value="#e6edf3" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#21262d" />
                                <Setter Property="Foreground" Value="#e6edf3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitlebarBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#8b949e" />
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#30363d" />
                                <Setter Property="Foreground" Value="#e6edf3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Titlebar -->
        <Border Grid.Row="0" Background="#161b22" BorderBrush="#30363d" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal" Margin="12,0" VerticalAlignment="Center">
                    <TextBlock Text="âœ¦" Foreground="#d29922" FontSize="16" Margin="0,0,8,0" />
                    <TextBlock Text="Boykisser Executor" Foreground="#8b949e" FontSize="13" VerticalAlignment="Center" />
                    <TextBlock Text="|" Foreground="#30363d" Margin="8,0" VerticalAlignment="Center" />
                    <Ellipse x:Name="BridgeDot" Width="8" Height="8" Fill="#3fb950" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="BridgeLabel" Text="Ready" Foreground="#3fb950" FontSize="11" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,4,0">
                    <Button x:Name="MinimizeBtn" Content="â”€" Style="{StaticResource TitlebarBtn}" Click="Minimize_Click" />
                    <Button x:Name="MaximizeBtn" Content="â–¡" Style="{StaticResource TitlebarBtn}" Click="Maximize_Click" />
                    <Button x:Name="CloseBtn" Content="âœ•" Style="{StaticResource TitlebarBtn}" Click="Close_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Body -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="#161b22" BorderBrush="#30363d" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#161b22" BorderBrush="#30363d" BorderThickness="0,0,0,1">
                        <Grid>
                            <TextBlock Text="SCRIPTS" Foreground="#6e7681" FontSize="11" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="12,0" />
                            <Button x:Name="NewScriptBtn" Content="+" Foreground="#8b949e" Background="Transparent"
                                    BorderThickness="0" FontSize="18" Cursor="Hand"
                                    HorizontalAlignment="Right" Width="24" Height="24" Margin="0,0,8,0"
                                    Click="NewScript_Click" />
                        </Grid>
                    </Border>

                    <ListView x:Name="TabList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                              SelectionMode="Single" SelectionChanged="TabList_SelectionChanged" />
                </Grid>
            </Border>

            <!-- Main panel -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="160" />
                </Grid.RowDefinitions>

                <!-- Toolbar -->
                <Border Grid.Row="0" Background="#161b22" BorderBrush="#30363d" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal" Margin="8,0">
                        <Button x:Name="InjectBtn" Content="âš¡ Inject" Style="{StaticResource ToolbarBtn}"
                                Background="#1a3a2a" BorderBrush="#2d5a3e" Foreground="#3fb950" Click="Inject_Click" />
                        <Button x:Name="ExecuteBtn" Content="â–¶ Execute" Style="{StaticResource ToolbarBtn}"
                                Margin="6,0,0,0" Background="#3a2e1a" BorderBrush="#5a4a2d" Foreground="#d29922" Click="Execute_Click" />
                        <Button x:Name="ClearBtn" Content="âŒ« Clear" Style="{StaticResource ToolbarBtn}" Margin="6,0,0,0" Click="Clear_Click" />
                        <Rectangle Width="1" Fill="#30363d" Margin="8,4" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,8,0">
                            <Button x:Name="OpenBtn" Content="ðŸ“‚ Open" Style="{StaticResource ToolbarBtn}" Click="Open_Click" />
                            <Button x:Name="SaveBtn" Content="ðŸ’¾ Save" Style="{StaticResource ToolbarBtn}" Margin="6,0,0,0" Click="Save_Click" />
                            <Button x:Name="SaveAsBtn" Content="Save As" Style="{StaticResource ToolbarBtn}" Margin="6,0,0,0" Click="SaveAs_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Monaco Editor -->
                <wv2:WebView2 x:Name="MonacoView" Grid.Row="1" Margin="0" />

                <!-- Output panel -->
                <Border Grid.Row="2" Background="#161b22" BorderBrush="#30363d" BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#161b22" BorderBrush="#30363d" BorderThickness="0,0,0,1">
                            <Grid>
                                <TextBlock Text="OUTPUT" Foreground="#6e7681" FontSize="11" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Margin="12,0" />
                                <Button x:Name="ClearOutputBtn" Content="Clear" Foreground="#8b949e" Background="Transparent"
                                        BorderThickness="0" FontSize="11" Cursor="Hand"
                                        HorizontalAlignment="Right" Margin="0,0,8,0" Click="ClearOutput_Click" />
                            </Grid>
                        </Border>

                        <ListBox x:Name="OutputList" Grid.Row="1" Background="Transparent" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Text}" Foreground="{Binding Color}"
                                               FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Status bar -->
        <Border x:Name="StatusBar" Grid.Row="1" VerticalAlignment="Bottom" Height="24"
                Background="#161b22" BorderBrush="#30363d" BorderThickness="0,1,0,0" IsHitTestVisible="False">
            <TextBlock x:Name="StatusText" Text="Ready" Foreground="#6e7681" FontSize="11"
                       Margin="12,0" VerticalAlignment="Center" />
        </Border>
    </Grid>
</Window>
